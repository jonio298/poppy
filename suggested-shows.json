[
  {
    "id": "life-in-song",
    "name": "A Life in Song (suggested)",
    "summary": "Opens in gratitude, rises through young love and family to a joyful peak, settles into a long love and a gentle goodnight, and closes with a blessing, so people leave comforted rather than only sad.",
    "songOrder": [
      1,
      2,
      3,
      5,
      4,
      6,
      7
    ],
    "chapters": [
      {
        "song": 1,
        "theme": "Where he came from",
        "slides": 13,
        "mood": "Warm and grateful. A boy in the 1930s and 40s, a young sailor, then the workshop, the home office and the grill he loved. A gentle count-your-blessings opening."
      },
      {
        "song": 2,
        "theme": "Falling in love",
        "slides": 12,
        "mood": "Tender and hopeful. The prom, the engagement, the 1959 wedding and the first years together as a couple and new parents."
      },
      {
        "song": 3,
        "theme": "Building a family",
        "slides": 10,
        "mood": "Devoted and proud. Family portraits through the 70s and 80s, the softball coach, the day trip to Williamsburg."
      },
      {
        "song": 5,
        "theme": "Joy and celebration",
        "slides": 21,
        "mood": "The high point: upbeat and laughing. Dancing, weddings and parties, the life of the party with Nanny at his side."
      },
      {
        "song": 4,
        "theme": "A love that lasted",
        "slides": 15,
        "mood": "Warm and steady. Carol and Charlie through the decades: the holiday parties, the 50th anniversary, quiet dinners, right up to their 67th."
      },
      {
        "song": 6,
        "theme": "A gentle goodnight",
        "slides": 21,
        "mood": "Soft and intimate. The later years: birthday candles, quiet afternoons, time with Carisa and the family. The room slows down."
      },
      {
        "song": 7,
        "theme": "Blessing and legacy",
        "slides": 23,
        "mood": "Hopeful and full-hearted. Children, grandchildren and great-grandchildren together, and the walk down the aisle. It ends on his portrait."
      }
    ],
